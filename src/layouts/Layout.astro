---
import { ClientRouter } from "astro:transitions";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import "@/styles/global.css";
import info from "@/data/info.json";

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results (used by the 404 page) */
  noindex?: boolean;
  ogType?: "website" | "profile" | "article";
  /** Overrides the default social-share image, e.g. with a blog post's hero image */
  image?: { url: string; width: number; height: number; alt?: string };
  /** Renders an RSS autodiscovery link */
  feedUrl?: string;
  article?: {
    headline?: string;
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
    author?: string;
  };
}

const {
  title = info.meta.title,
  description = info.meta.description,
  noindex = false,
  ogType = "website",
  image,
  feedUrl,
  article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL(info.meta.ogImage, Astro.site);
const resolvedImage = image
  ? { url: image.url, width: image.width, height: image.height, alt: image.alt ?? info.meta.ogImageAlt }
  : { url: defaultOgImage.href, width: 1200, height: 630, alt: info.meta.ogImageAlt };
const portrait = new URL("/mitch.webp", Astro.site);
const logo = new URL("/logo.png", Astro.site);
const siteUrl = new URL("/", Astro.site).href;
const [region] = info.resume.location.split(", ");

// Structured data describing the person, the business and the site
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: info.name,
      alternateName: info.business.tradingName,
      inLanguage: "en-ZA",
      publisher: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: info.name,
      givenName: info.firstName,
      familyName: info.lastName,
      url: siteUrl,
      image: portrait.href,
      jobTitle: info.role.charAt(0).toUpperCase() + info.role.slice(1),
      email: info.business.email,
      address: {
        "@type": "PostalAddress",
        addressRegion: region,
        addressCountry: "ZA",
      },
      sameAs: info.socials.map((s) => s.href).filter((href) => href.startsWith("https://")),
      worksFor: { "@id": `${siteUrl}#business` },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}#business`,
      name: info.business.tradingName,
      url: siteUrl,
      logo: logo.href,
      image: defaultOgImage.href,
      description: info.freelance.description,
      email: info.business.email,
      founder: { "@id": `${siteUrl}#person` },
      address: {
        "@type": "PostalAddress",
        addressRegion: region,
        addressCountry: "ZA",
      },
      knowsAbout: info.freelance.services,
    },
    ...(ogType === "article" && article
      ? [
          {
            "@type": "BlogPosting",
            "@id": `${canonical.href}#article`,
            mainEntityOfPage: canonical.href,
            url: canonical.href,
            headline: article.headline ?? title,
            description,
            image: resolvedImage.url,
            datePublished: article.publishedTime.toISOString(),
            ...(article.modifiedTime && { dateModified: article.modifiedTime.toISOString() }),
            ...(article.tags?.length && { keywords: article.tags.join(", ") }),
            inLanguage: "en-ZA",
            author: { "@id": `${siteUrl}#person` },
            publisher: { "@id": `${siteUrl}#person` },
            isPartOf: { "@id": `${siteUrl}#website` },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={info.meta.themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    {feedUrl && (
      <link rel="alternate" type="application/rss+xml" title={`${info.meta.ogSiteName} Blog`} href={feedUrl} />
    )}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/contours.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="preload" href="/jetbrains.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage.url} />
    <meta property="og:image:alt" content={resolvedImage.alt} />
    <meta property="og:image:width" content={String(resolvedImage.width)} />
    <meta property="og:image:height" content={String(resolvedImage.height)} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={info.meta.ogSiteName} />
    <meta property="og:locale" content={info.meta.locale} />
    {ogType === "profile" && <meta property="profile:first_name" content={info.firstName} />}
    {ogType === "profile" && <meta property="profile:last_name" content={info.lastName} />}
    {ogType === "article" && article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
        {article.author && <meta property="article:author" content={article.author} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage.url} />
    <meta name="twitter:image:alt" content={resolvedImage.alt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body class="bg-(--background) sm:px-28 lg:px-20 px-9 relative overflow-x-hidden" transition:persist style="view-transition-name: none;">
    <Nav />
    <div class="contours-top" transition:persist></div>
    <div style="view-transition-name: page-content;">
      <slot />
      <Footer />
    </div>
    <div class="contours-bottom" transition:persist></div>
  </body>
</html>

<style is:global>

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-display: swap;
    font-weight: 100 800;
    src: url('/jetbrains.woff2') format('woff2');
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "JetBrains Mono",
      ui-monospace,
      monospace;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Contours background */
  .contours-top,
  .contours-bottom {
    position: absolute;
    left: 0;
    width: 100%;
    height: 800px;
    background-image: url(/contours.svg);
    filter: invert(1);
    mix-blend-mode: color-dodge;
    background-repeat: no-repeat;
    background-size: cover;
    z-index: -47;
    opacity: 0.7;
    color: #fff;
    pointer-events: none;
    view-transition-name: none;
  }

  .contours-top {
    top: 0;
    background-position: top center;
  }

  .contours-bottom {
    bottom: 0;
    background-position: bottom center;
    transform: scaleY(-1);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  /* Card tilt hover effect */
  .tilt-card {
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .tilt-card:hover {
    transform: perspective(800px) rotateX(1deg) rotateY(-1deg) translateY(-4px);
    box-shadow: 4px 8px 24px rgba(0, 0, 0, 0.25);
  }

  /* View Transitions animations */
  ::view-transition-old(root) {
    animation: none;
  }

  ::view-transition-new(root) {
    animation: none;
  }

  /* Keep the nav on its own layer so the fading page content never draws over it */
  ::view-transition-group(site-nav) {
    animation: none;
    z-index: 10;
  }

  ::view-transition-old(site-nav) {
    display: none;
  }

  ::view-transition-new(site-nav) {
    animation: none;
  }

  ::view-transition-old(page-content) {
    animation: fadeOut 0.3s ease-in-out forwards;
    z-index: 1;
  }

  ::view-transition-new(page-content) {
    animation: fadeIn 0.3s ease-in-out forwards;
    z-index: 2;
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
