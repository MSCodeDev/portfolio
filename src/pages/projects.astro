---
import Layout from "@/layouts/Layout.astro";
import projects from "@/data/projects.json";
import { tagLabel, statusColor } from "@/utils/tags";

// Get all projects and sort by startYear (desc), then title (asc)
const sortedProjects = [...projects].sort((a, b) => {
  const yearDiff = b.startYear - a.startYear;
  if (yearDiff !== 0) return yearDiff;
  return a.title.localeCompare(b.title);
});

// Tags ordered by how many projects use them (then A to Z), with the count shown on each chip
const tagCounts = new Map<string, number>();
for (const project of sortedProjects) for (const tag of project.tags ?? []) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }));
const VISIBLE_TAGS = 6;
---

<Layout
  title="Projects | Mitch Stroebel"
  description="Websites, web applications and apps built by Mitch Stroebel, filterable by technology."
>

  <main class="max-w-5xl mx-auto space-y-8 md:mt-36 my-8">
    <div class="mb-12">
      <h1 class="text-5xl md:text-6xl font-bold text-[var(--white)] mb-4">
        Projects
      </h1>
      <p class="text-xl text-[var(--white-icon)]">
        A collection of my web development projects and contributions.
      </p>
    </div>

    <!-- Tag filter -->
    <div class="flex flex-wrap gap-2 md:gap-3 mb-8" id="tag-filters">
      <label class="tag-filter">
        <input type="radio" name="tag" value="" class="sr-only" checked />
        <span class="inline-flex items-center gap-1.5 cursor-pointer text-sm px-3 py-1.5 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:border-[var(--sec)] hover:text-[var(--sec)] transition-colors">All <span class="count text-xs opacity-60">{sortedProjects.length}</span></span>
      </label>
      {allTags.map(({ tag, count }, i) => (
        <label class:list={["tag-filter", i >= VISIBLE_TAGS && "extra-tag hidden"]}>
          <input type="radio" name="tag" value={tag} class="sr-only" />
          <span class="inline-flex items-center gap-1.5 cursor-pointer text-sm px-3 py-1.5 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:border-[var(--sec)] hover:text-[var(--sec)] transition-colors">{tagLabel(tag)} <span class="count text-xs opacity-60">{count}</span></span>
        </label>
      ))}
      {allTags.length > VISIBLE_TAGS && (
        <button type="button" id="tag-more" class="text-sm px-3 py-1.5 rounded-full border border-dashed border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:border-[var(--sec)] hover:text-[var(--sec)] transition-colors cursor-pointer" data-more={`+${allTags.length - VISIBLE_TAGS} more`}>
          +{allTags.length - VISIBLE_TAGS} more
        </button>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sortedProjects.map((project) => (
        <article data-tags={JSON.stringify(project.tags ?? [])} class="tilt-card bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-lg overflow-hidden flex flex-col">
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class={`text-xs px-2.5 py-1 border rounded-full ${statusColor(project.status)}`}>
                {project.status}
              </span>
              <span class={`text-sm shrink-0 ${project.highlight ? 'text-purple-400' : 'text-[var(--white-icon)]'}`}>
                {project.startYear}{project.endYear ? ` to ${project.endYear}` : ''}
              </span>
            </div>

            <h2 class={`text-2xl font-bold mb-2 ${project.highlight ? 'text-purple-400' : 'text-[var(--white)]'}`}>
              {project.title}
            </h2>

            <p class={`mb-4 line-clamp-5 flex-1 ${project.highlight ? 'text-purple-400/70' : 'text-[var(--white-icon)]'}`}>
              {project.description}
            </p>

            <div class="flex flex-wrap items-center gap-2 mt-auto">
              {project.tags && project.tags.map((tag: string) => (
                <span class={`text-[0.8rem] px-2.5 py-1 rounded-full border ${project.highlight ? 'border-purple-500/30 bg-purple-500/10 text-purple-400' : 'border-[var(--white-icon-tr)] text-[var(--white-icon)]'}`}>
                  {tagLabel(tag)}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    {sortedProjects.length === 0 && (
      <div class="text-center py-12">
        <p class="text-xl text-[var(--white-icon)]">
          No projects yet. Check back soon!
        </p>
      </div>
    )}
  </main>

</Layout>

<style>
  .line-clamp-5 {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tag-filter input:checked + span {
    border-color: var(--sec);
    background-color: var(--sec);
    color: var(--background);
  }
</style>

<script>
  const filters = document.getElementById('tag-filters');
  const grid = document.querySelector('.grid');
  const moreButton = document.getElementById('tag-more');

  filters?.addEventListener('change', (e) => {
    const selected = (e.target as HTMLInputElement).value;
    grid?.querySelectorAll<HTMLElement>('article[data-tags]').forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      card.style.display = (!selected || tags.includes(selected)) ? '' : 'none';
    });
  });

  moreButton?.addEventListener('click', () => {
    const extras = filters?.querySelectorAll<HTMLElement>('.extra-tag') ?? [];
    const opening = extras[0]?.classList.contains('hidden');
    extras.forEach((el) => el.classList.toggle('hidden', !opening));
    moreButton.textContent = opening ? 'Show fewer' : moreButton.dataset.more ?? '';
  });
</script>
