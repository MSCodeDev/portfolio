---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import LetterGlitch from "@/components/glitch.astro";
import LogoWall from "@/components/logos.astro";
import SkillsList from "@/components/skills.astro";
import projects from "@/data/projects.json";
import timeline from "@/data/timeline.json";
import info from "@/data/info.json";
import { tagLabel, statusColor } from "@/utils/tags";

// The hero bio starts a sentence, so the highlighted role is capitalised
const roleTitle = info.role.charAt(0).toUpperCase() + info.role.slice(1);

// Timeline
const homeTimeline = timeline.filter((item) => item.homepage);

// Projects
const latestProjects = projects
  .filter((p) => p.featured === true)
  .sort((a, b) => {
    const yearDiff = b.startYear - a.startYear;
    if (yearDiff !== 0) return yearDiff;
    return a.title.localeCompare(b.title);
  });


---

<Layout title={info.meta.title}>
  <!-- Home -->
  <section class="text-[var(--white)]" id="home">
    <div class="max-w-5xl mx-auto space-y-8 mt-8 md:mt-36 pb-12">
      <div class="text-center lg:text-left space-y-6">
        <div class="flex flex-wrap items-baseline justify-center lg:justify-start gap-x-3 md:gap-x-4">
          <p class="text-3xl lg:text-4xl text-[var(--white-icon)] shiny-white">
            {info.greeting}
          </p>
          <h1
            class="text-[var(--white)] text-3xl lg:text-4xl font-semibold leading-none"
          >
            {info.firstName} {info.lastName}
          </h1>
        </div>
        <div class="flex flex-col items-center lg:flex-row lg:items-center gap-5 md:gap-8">
          <img
            src="/mitch.webp"
            alt={`Portrait of ${info.name}`}
            width="480"
            height="480"
            decoding="async"
            fetchpriority="high"
            class="shrink-0 w-36 h-36 sm:w-44 sm:h-44 lg:w-56 lg:h-56 rounded-2xl object-cover border border-[var(--white-icon-tr)]"
          />
          <div class="w-full lg:w-auto space-y-4 md:space-y-6">
            <p class="text-[15px] leading-6 md:text-lg md:leading-7 lg:text-xl text-pretty text-[var(--white-icon)]" set:html={info.bio.replace('{role}', `<span class="text-[var(--sec)] shiny-sec">${roleTitle}</span>`)} />
            <div class="flex justify-center lg:justify-start gap-3 md:gap-5">
              {info.socials.map((social) => (
                <a
                  target="_blank"
                  href={social.href}
                  aria-label={social.label}
                  class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                >
                  <Icon name={social.icon} class={`${social.icon.startsWith('simple-icons:') ? 'w-7 h-7' : 'w-8 h-8'}`} />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <LogoWall />

      <div class="flex flex-col lg:flex-row items-center gap-8">
        <SkillsList />
        <div
          class="flex justify-center md:w-full md:h-[292px] size-[290px] md:ml-16"
        >
          <LetterGlitch
            glitchColors={["#5e4491", "#A476FF", "#241a38"]}
            glitchSpeed={33}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section
    id="projects"
    class="text-[var(--white)] pt-12"
  >
    <div class="max-w-5xl mx-auto">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{info.sections.projects.label}</h2>
      <div class="flex items-center justify-between mb-8">
        <h3 class="text-4xl md:text-5xl font-medium">{info.sections.projects.title}</h3>
        <a 
          href="/projects"
          class="inline-flex items-center gap-2 px-3 md:px-6 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg font-semibold border border-[var(--white-icon-tr)] hover:bg-[var(--sec)] hover:border-[var(--sec)] hover:text-[var(--background)] transition-all"
        >
          <Icon name="heroicons:arrow-top-right-on-square-20-solid" class="w-5 h-5" />
          <span class="hidden md:inline">{info.sections.projects.viewAllText}</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        {latestProjects.map((project) => (
          <div class="tilt-card bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-lg overflow-hidden flex flex-col">
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h4 class="text-xl font-semibold text-[var(--white)]">
                  {project.title}
                </h4>
                <span class={`shrink-0 text-xs px-2.5 py-1 border rounded-full ${statusColor(project.status)}`}>
                  {project.status}
                </span>
              </div>
              <p class="text-[var(--white-icon)] mb-4 line-clamp-4 flex-1">
                {project.description}
              </p>
              <div class="flex flex-wrap items-center gap-2 mt-auto">
                {project.tags && project.tags.slice(0, 4).map((tag: string) => (
                  <span class="text-[0.8rem] px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                    {tagLabel(tag)}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="video-fade relative flex items-center justify-center overflow-hidden bg-black mix-blend-lighten h-[650px] md:h-[800px] -mt-[250px] -mb-[300px] -z-10">
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute top-0 left-0 w-full h-full object-contain mix-blend-screen"
    >
      <source src="/blackhole.webm" type="video/webm" />
    </video>
  </section>

  <!-- Resume -->
  <section id="resume" class="w-full py-12">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{info.sections.resume.label}</h2>
      <div class="flex items-center justify-between mb-8">
        <h3 class="text-3xl font-medium text-[var(--white)]">
          {info.sections.resume.title}
        </h3>
        <a 
          href="/resume"
          class="inline-flex items-center gap-2 px-3 md:px-6 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg font-semibold border border-[var(--white-icon-tr)] hover:bg-[var(--sec)] hover:border-[var(--sec)] hover:text-[var(--background)] transition-all"
        >
          <Icon name="heroicons:arrow-top-right-on-square-20-solid" class="w-5 h-5" />
          <span class="hidden md:inline">{info.sections.resume.viewAllText}</span>
        </a>
      </div>

      <div class="timeline-line relative pl-10 ml-3">
        {homeTimeline.map((item) => (
          <div class="relative mb-8 last:mb-0">
            {item.icon ? (
              <div class={`absolute -left-[3.1rem] top-4 w-5 h-5 flex items-center justify-center ${item.type === 'award' ? 'text-amber-400' : 'text-[var(--sec)]'}`}>
                <Icon name={item.icon} class="w-5 h-5" />
              </div>
            ) : (
              <div class={`absolute -left-[3.1rem] top-4 w-5 h-5 rounded-full bg-[var(--background)] border-2 flex items-center justify-center ${item.type === 'award' ? 'border-amber-400' : 'border-[var(--sec)]'}`}>
                <div class={`w-2 h-2 rounded-full ${item.type === 'award' ? 'bg-amber-400' : 'bg-[var(--sec)]'}`} />
              </div>
            )}
            <div class="tilt-card bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-4">
              <div class="flex items-start gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h4 class="text-lg font-semibold text-[var(--white)]">
                        {item.title}
                      </h4>
                      {item.type === "award" && (
                        <span class="text-[0.65rem] px-1.5 py-0.5 rounded-sm bg-amber-400/15 text-amber-400 uppercase tracking-wider">Award</span>
                      )}
                    </div>
                    <span class="text-xs text-[var(--white-icon)] shrink-0">{item.year}</span>
                  </div>
                  <p class={`text-sm ${item.type === 'award' ? 'text-amber-400' : 'text-[var(--sec)]'}`}>
                    {item.subtitle}
                  </p>
                </div>
              </div>
              {item.shortDescription && (
                <p class="text-[var(--white-icon)] text-sm mt-2">
                  {item.shortDescription}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Freelance -->
  <section id="freelance" class="w-full py-12 text-[var(--white)]">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{info.freelance.label}</h2>
      <h3 class="text-3xl font-medium mb-8">{info.freelance.title}</h3>

      <div class="tilt-card bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-xl p-6">
        <p class="text-[var(--white-icon)] text-sm md:text-base mb-4">
          {info.freelance.description}
        </p>
        <div class="flex flex-wrap items-center gap-2 mb-6">
          {info.freelance.services.map((service) => (
            <span class="text-xs px-2 py-1 bg-[var(--white-icon-tr)] text-[var(--white-icon)] rounded-sm">
              {service}
            </span>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={info.freelance.ctaHref}
            class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg font-semibold border border-[var(--white-icon-tr)] hover:bg-[var(--sec)] hover:border-[var(--sec)] hover:text-[var(--background)] transition-all"
          >
            <Icon name="heroicons:envelope-20-solid" class="w-5 h-5" />
            <span>{info.freelance.ctaText}</span>
          </a>
          <a
            href="/terms"
            class="text-sm text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out underline underline-offset-4"
          >
            {info.freelance.termsText}
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-fade {
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 48%, black 82%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 48%, black 82%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, black 48%, black 82%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 48%, black 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .timeline-line::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--white-icon-tr) 15%,
      var(--white-icon-tr) 85%,
      transparent
    );
  }
</style>
