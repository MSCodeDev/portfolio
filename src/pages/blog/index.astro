---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat = new Intl.DateTimeFormat("en-ZA", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="Blog | Mitch Stroebel"
  description="Writing on software development, self-hosting, open source and AI tooling by Mitch Stroebel."
>
  <main class="max-w-5xl mx-auto space-y-8 md:mt-36 my-8">
    <div class="mb-12">
      <h1 class="text-5xl md:text-6xl font-bold text-[var(--white)] mb-4">
        Blog
      </h1>
      <p class="text-xl text-[var(--white-icon)]">
        Notes on software development, self-hosting and the tools I actually use.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="tilt-card bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-lg overflow-hidden flex flex-col sm:flex-row"
        >
          {post.data.heroImage && (
            <Image
              src={post.data.heroImage}
              alt={post.data.title}
              width={480}
              height={480}
              format="webp"
              class="w-full sm:w-56 md:w-64 shrink-0 aspect-video sm:aspect-square object-cover"
            />
          )}
          <div class="flex flex-col flex-1 p-6 min-w-0">
          <div class="flex items-center justify-between gap-4 mb-3">
            <time datetime={post.data.pubDate.toISOString()} class="text-sm text-[var(--white-icon)]">
              {dateFormat.format(post.data.pubDate)}
            </time>
          </div>

          <h2 class="text-2xl font-bold mb-2 text-[var(--white)]">
            {post.data.title}
          </h2>

          <p class="mb-4 line-clamp-3 text-[var(--white-icon)]">
            {post.data.description}
          </p>

          <div class="flex flex-wrap items-center gap-2 mt-auto">
            {post.data.tags.map((tag) => (
              <span class="text-[0.8rem] px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                {tag}
              </span>
            ))}
          </div>
          </div>
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-xl text-[var(--white-icon)]">
          No posts yet. Check back soon!
        </p>
      </div>
    )}
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
