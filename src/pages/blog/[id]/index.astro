---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat("en-ZA", { year: "numeric", month: "long", day: "numeric" });

const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const heroAlt = post.data.heroImageAlt ?? post.data.title;

// Use the post's own hero image as the social-share preview, falling back to the site default
let shareImage;
if (post.data.heroImage) {
  const optimized = await getImage({ src: post.data.heroImage, width: 1200, height: 1200, format: "jpg" });
  shareImage = {
    url: new URL(optimized.src, Astro.site).href,
    width: optimized.attributes.width,
    height: optimized.attributes.height,
    alt: heroAlt,
  };
}
---

<Layout
  title={`${post.data.title} | Mitch Stroebel`}
  description={post.data.description}
  ogType="article"
  image={shareImage}
  feedUrl="/rss.xml"
  article={{
    headline: post.data.title,
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: post.data.tags,
    author: post.data.author,
  }}
>
  <main class="max-w-3xl mx-auto md:mt-36 my-8">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1.5 text-sm text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors mb-8"
    >
      &larr; Back to blog
    </a>

    {post.data.heroImage && (
      <Image
        src={post.data.heroImage}
        alt={heroAlt}
        width={800}
        height={800}
        format="webp"
        class="w-full max-w-md mx-auto aspect-square object-cover rounded-lg border border-[var(--white-icon-tr)] mb-8"
      />
    )}

    <div class="mb-10">
      <div class="flex items-center gap-3 text-sm text-[var(--white-icon)] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-[var(--white)] mb-4 text-pretty">
        {post.data.title}
      </h1>
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-[0.8rem] px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <article class="post-content text-[var(--white-icon)]">
      <Content />
    </article>
  </main>
</Layout>

<style>
  .post-content {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-content > :global(* + *) {
    margin-top: 1.5em;
  }

  .post-content :global(h2) {
    color: var(--white);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5em;
    margin-bottom: 0.25em;
  }

  .post-content :global(h3) {
    color: var(--white);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.25em;
  }

  .post-content :global(a) {
    color: var(--sec);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--sec) 40%, transparent);
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--sec);
  }

  .post-content :global(strong) {
    color: var(--white);
    font-weight: 600;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5em;
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li + li) {
    margin-top: 0.5em;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--white-icon-tr);
    padding-left: 1em;
    color: var(--white-icon);
    font-style: italic;
  }

  .post-content :global(code) {
    background: var(--white-icon-tr);
    color: var(--white);
    padding: 0.15em 0.4em;
    border-radius: 0.3em;
    font-size: 0.875em;
  }

  .post-content :global(pre) {
    background: #1414149c;
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.5em;
    padding: 1em;
    overflow-x: auto;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(img) {
    display: block;
    width: 100%;
    border-radius: 0.5em;
    border: 1px solid var(--white-icon-tr);
  }

  .post-content :global(img + em) {
    display: block;
    text-align: center;
    font-size: 0.875rem;
    color: var(--white-icon);
    opacity: 0.75;
    margin-top: 0.5em !important;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--white-icon-tr);
    padding: 0.5em 0.75em;
    text-align: left;
  }

  .post-content :global(th) {
    color: var(--white);
    background: var(--white-icon-tr);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--white-icon-tr);
  }
</style>
