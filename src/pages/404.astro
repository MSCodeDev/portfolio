---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found | Mitch Stroebel" description="The page you were looking for could not be found."
  noindex
>
  <main class="max-w-5xl mx-auto space-y-8 md:mt-36 my-8 min-h-[40vh]">
    <div>
      <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">404</p>
      <h1 class="text-5xl md:text-6xl font-bold text-[var(--white)] mb-4">
        Page not found
      </h1>
      <p class="text-xl text-[var(--white-icon)] mb-8">
        That page doesn't exist or has moved.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-[var(--sec)] text-[var(--background)] rounded-lg font-semibold hover:opacity-90 transition-opacity"
      >
        Back to home
      </a>
    </div>
  </main>
</Layout>
